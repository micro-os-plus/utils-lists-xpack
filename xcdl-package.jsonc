{
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 Liviu Ionescu. All rights reserved.",
  "cdlPackage": {
    "display": "µOS++ Intrusive Lists",
    "description": "A source code library with the µOS++ intrusive lists",
    "cdlComponents": [
      {
        "name": "micro-os-plus.utils.lists",
        "display": "Intrusive Lists",
        "description": "µOS++ C++ Intrusive Lists",
        "publicIncludeFolders": [
          "include"
        ],
        "sourceFiles": [
          "src/doubly-list-links.cpp"
        ],
        // Note: artefact "compilerOptions" must include `-std=c++20` or higher.
        "dependencies": [
          "micro-os-plus.diag.trace"
        ],
        "generatedFile": {
          "type": "header",
          "filePath": "{{buildFolderPath}}/generated/include/micro-os-plus/utils/lists-defines.h"
        },
        // "$commentDefine": "MICRO_OS_PLUS_UTILS_LISTS_ENABLED",
        "cdlOptions": [
          {
            "name": "trace",
            "display": "Enable trace in lists",
            "description": "Display trace messages in lists when TRACE is enabled",
            "requires": "isEnabled('micro-os-plus.diag.trace')",
            "defaultValue": false,
            // "$commentDefine": "MICRO_OS_PLUS_UTILS_LISTS_TRACE_ENABLED"
          },
          {
            "name": "trace-constructors",
            "display": "Enable trace in lists constructors",
            "description": "Display trace messages in lists constructors and descriptors when TRACE is enabled",
            "requires": "isEnabled('micro-os-plus.diag.trace')",
            "defaultValue": false,
            // "$commentDefine": "MICRO_OS_PLUS_UTILS_LISTS_TRACE_CONSTRUCTORS_ENABLED"
          }
        ],
        "cdlArtefacts": [
          {
            "name": "static",
            "display": "Static Library",
            "description": "Static library with the µOS++ intrusive lists",
            "type": "staticLibrary",
            // This generates libutils-lists.a on Linux/macOS and 
            // utils-lists.lib on Windows.
            "fileName": "utils-lists",
            "dependencies": [
              "micro-os-plus.utils.lists"
            ]
          },
          {
            "name": "objects",
            "display": "Object Files",
            "description": "Object files with the µOS++ intrusive lists",
            "type": "objectFiles",
            "dependencies": [
              "micro-os-plus.utils.lists"
            ]
          }
        ]
      }
    ]
  }
}