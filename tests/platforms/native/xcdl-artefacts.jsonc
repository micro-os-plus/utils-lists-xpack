{
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 Liviu Ionescu. All rights reserved.",
  "includeCDLs": [
    "xcdl/platform-library.jsonc"
  ],
  "cdlArtefacts": [
    {
      "id": "sample.binary",
      "display": "Sample Test Executable",
      "description": "The executable generated by the sample test",
      "type": "executable",
      "fileName": "sample-test{{ executableSuffix }}",
      "dependencies": [
        "tests.sample",
        "micro-os-plus.platforms.native"
      ],
      "cdlArtefacts": [
        {
          "id": "size",
          "display": "Sample Test Size",
          "description": "Show the size of the sample test executable",
          "type": "command",
          "command": "size sample-test.elf",
          "dependencies": [
            "tests.sample.binary"
          ],
          "defaultEnabled": "isEnabled('tests.common.report-size')"
        },
        {
          "id": "listing",
          "display": "Sample Test Listing",
          "description": "Show the disassembly listing of the sample test executable",
          "type": "command",
          "command": "objdump --source --all-headers --demangle --line-numbers --wide sample-test{{ executableSuffix }} > sample-test-list.txt",
          "dependencies": [
            "tests.sample.binary"
          ],
          "defaultEnabled": "isEnabled('tests.common.create-listing')"
        }
      ]
    },
    {
      "id": "unit.binary",
      "display": "Unit Test Executable",
      "description": "The executable generated by the unit test",
      "type": "executable",
      "fileName": "unit-test{{ executableSuffix }}",
      "dependencies": [
        "tests.unit",
        "micro-os-plus.platforms.native"
      ]
    }
  ],
  "cdlTests": [
    {
      "id": "sample.runner",
      "display": "Sample Test Runner",
      "description": "A simple test to exercise an object linked into multiple lists",
      "dependencies": [
        "tests.sample.binary"
      ]
    },
    {
      "id": "unit.runner",
      "display": "Unit Test Runner",
      "description": "A comprehensive test for all lists",
      "dependencies": [
        "tests.unit.binary"
      ]
    },
    {
      "id": "unit.runnerCoverage",
      "display": "Unit Test Runner with Coverage",
      "description": "A comprehensive test for all lists with coverage",
      "dependencies": [
        "tests.unit.runner"
      ]
    }
  ]
}