{
  // DO NOT EDIT!
  // Automatically generated from build-helper/templates.
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 Liviu Ionescu. All rights reserved.",
  "includeCDLs": [
    "xcdl/platform-library.jsonc"
  ],
  "properties": {
    // Device name required in devices-qemu-cortexm.
    "platformDefine": "MICRO_OS_PLUS_DEVICE_QEMU_CORTEX_M0",
    "deviceDefine": "MICRO_OS_PLUS_DEVICE_QEMU_CORTEX_M0"
  },
  "cdlComponents": [
    {
      "id": "qemu-cortex-m0",
      "display": "QEMU Cortex-M0 Platform",
      "description": "Runs an µOS++ application in QEMU Cortex-M0 emulation",
      "publicIncludeFolders": [
        "include"
      ],
      "sourceFiles": [],
      // For full POSIX conformance, C programs shall define _POSIX_C_SOURCE 
      // to be 200809L before any header is included:
      // https://pubs.opengroup.org/onlinepubs/9699919799/basedefs/V1_chap02.html#tag_02_01_03
      "publicDefines": [
        "_POSIX_C_SOURCE=200809L",
        // For S_IREAD
        "_GNU_SOURCE",
        "{{properties.platformDefine}}",
        "{{properties.deviceDefine}}"
      ],
      "publicCompilerOptions": {
        "target": [
          "-mcpu=cortex-m0",
          "-mthumb",
          "-mfloat-abi=soft"
          // "-fno-move-loop-invariants",
        ],
        "warnings": [
          // Embedded builds must always be warning free.
          "-Werror"
        ],
        "optimisations": [
          // -flto fails to run on QEMU.
          // "{% if buildType == 'release' or buildType == 'minSize' %}-flto{% endif %}"
          "{% if buildType == 'debug' %}-fno-omit-frame-pointer{% endif %}",
          "{% if compile.language == 'cpp' %}-fno-threadsafe-statics{% endif %}"
        ],
        "linker": [
          "-nostartfiles",
          "-Wl,--gc-sections",
          // TODO: compare as version, not strings.
          "{% if compiler.version | semver_ge: '12.0.0' %}-Wl,--no-warn-rwx-segment{% endif %}",
          // Including files from other packages is not very nice, but functional. 
          // Use absolute paths, otherwise set -L.
          "-T{{buildFolderAbsolutePath}}/xpacks/@micro-os-plus/devices-qemu-cortexm/linker-scripts/mem-mps2-an385.ld",
          "-T{{buildFolderAbsolutePath}}/xpacks/@micro-os-plus/architecture-cortexm/linker-scripts/sections-flash.ld"
        ]
      },
      "implements": [
        "micro-os-plus.platform"
      ],
      "dependencies": [
        "micro-os-plus.device",
        "micro-os-plus.core.startup",
        "micro-os-plus.semihosting"
      ]
      // "customDefine": "{{properties.platformDefine}}",
    }
  ]
}