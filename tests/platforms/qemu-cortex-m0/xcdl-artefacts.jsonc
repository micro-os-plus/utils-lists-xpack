{
  "$schema": "https://xpack.github.io/xcdl/schemas/xcdl-2.0.0.json",
  "minimumXcdlRequired": "2.0.0",
  "license": "MIT",
  "copyright": "Copyright (c) 2026 Liviu Ionescu. All rights reserved.",
  "cdlArtefacts": [
    {
      "name": "sample.binary",
      "display": "Sample Test Executable",
      "description": "The executable generated by the sample test",
      "type": "executable",
      "fileName": "sample-test.elf",
      "dependencies": [
        "tests.common.compiler-options",
        "tests.sample",
        "micro-os-plus.platform"
      ],
      "cdlArtefacts": [
        {
          "name": "size",
          "display": "Sample Test Size",
          "description": "Show the size of the sample test executable",
          "type": "command",
          "command": "arm-none-eabi-size --format=berkeley sample-test.elf",
          "dependencies": [
            "tests.sample.binary"
          ],
          "defaultEnabled": "isEnabled('tests.common.report-size')"
        },
        {
          "name": "hex",
          "display": "Sample Test Hex",
          "description": "Create the hex binary of the sample test executable",
          "type": "command",
          "command": "arm-none-eabi-objcopy -O ihex sample-test.elf sample-test.hex",
          "dependencies": [
            "tests.sample.binary"
          ],
          "defaultEnabled": "isEnabled('tests.common.create-hex')"
        },
        {
          "name": "listing",
          "display": "Sample Test Listing",
          "description": "Show the disassembly listing of the sample test executable",
          "type": "command",
          "command": "arm-none-eabi-objdump --source --all-headers --demangle --line-numbers --wide sample-test.elf > sample-test-list.txt",
          "dependencies": [
            "tests.sample.binary"
          ],
          "defaultEnabled": "isEnabled('tests.common.create-listing')"
        }
      ]
    },
    {
      "name": "unit.binary",
      "display": "Unit Test Executable",
      "description": "The executable generated by the unit test",
      "type": "executable",
      "fileName": "unit-test.elf",
      "dependencies": [
        "tests.common.compiler-options",
        "tests.unit",
        "micro-os-plus.platform"
      ],
      "cdlArtefacts": [
        {
          "name": "size",
          "display": "Unit Test Size",
          "description": "Show the size of the unit test executable",
          "type": "command",
          "command": "arm-none-eabi-size --format=berkeley unit-test.elf",
          "dependencies": [
            "tests.unit.binary"
          ],
          "defaultEnabled": "isEnabled('tests.common.report-size')"
        },
        {
          "name": "hex",
          "display": "Unit Test Hex",
          "description": "Create the hex binary of the unit test executable",
          "type": "command",
          "command": "arm-none-eabi-objcopy -O ihex unit-test.elf unit-test.hex",
          "dependencies": [
            "tests.unit.binary"
          ],
          "defaultEnabled": "isEnabled('tests.common.create-hex')"
        },
        {
          "name": "listing",
          "display": "Unit Test Listing",
          "description": "Show the disassembly listing of the unit test executable",
          "type": "command",
          "command": "arm-none-eabi-objdump --source --all-headers --demangle --line-numbers --wide unit-test.elf > unit-test-list.txt",
          "dependencies": [
            "tests.unit.binary"
          ],
          "defaultEnabled": "isEnabled('tests.common.create-listing')"
        }
      ]
    }
  ],
  "cdlTests": [
    {
      "name": "sample.runner",
      "display": "Sample Test Runner",
      "description": "A simple test to exercise an object linked into multiple lists",
      "command": "qemu-system-arm{{extension}} --machine mps2-an385 --cpu cortex-m3 --kernel sample-test.elf --nographic -d unimp,guest_errors --semihosting-config enable=on,target=native,arg=sample-test,arg=one,arg=two",
      "dependencies": [
        "tests.sample.binary"
      ]
    },
    {
      "name": "unit.runner",
      "display": "Unit Test Runner",
      "description": "A comprehensive test for all lists",
      // --verbose
      "command": "qemu-system-arm{{extension}} --machine mps2-an385 --cpu cortex-m3 --kernel unit-test.elf --nographic -d unimp,guest_errors --semihosting-config enable=on,target=native,arg=unit-test",
      "dependencies": [
        "tests.unit.binary"
      ]
    }
  ]
}